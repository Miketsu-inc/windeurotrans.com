---
/* The two ways to reach us, as a button pair: call first, email second. */
import Icon from "./Icon.astro";
import { site, mailto } from "../data/site";

interface Props {
  /** Names the service or temperature in the email subject. */
  topic?: string;
  /** "dark" on blue backgrounds, "light" on ice and white. */
  tone?: "dark" | "light";
  class?: string;
}

const { topic, tone = "dark", class: className = "flex flex-col gap-3 sm:flex-row" } = Astro.props;
---

<div class={className}>
  <a href={site.phoneHref} class="btn btn-signal tnum">
    <Icon name="phone" class="size-4.5" />
    Call {site.phone}
  </a>
  <a href={mailto(topic)} class:list={["btn", tone === "dark" ? "btn-outline-light" : "btn-outline"]}>
    <Icon name="mail" class="size-4.5" />
    Email us
  </a>
</div>
