---
import ContactButtons from "./ContactButtons.astro";

interface Props {
  title?: string;
  text?: string;
  /** Names the service in the email subject. */
  topic?: string;
  /** Background of the band around the panel, to differ from the section above it. */
  surface?: "ice" | "frost";
}

const {
  title = "Tell us what needs to move.",
  text = "Send us the pickup, delivery and cargo. You get a price and a transit time, usually within one working day.",
  topic,
  surface = "ice",
} = Astro.props;
---

<div class:list={[surface === "frost" && "bg-frost"]}>
  <section class="wrap py-12 md:py-16">
    <div class="sign-panel px-7 py-10 sm:px-10 md:px-14 md:py-12">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
        <div class="max-w-xl">
          <h2 class="text-[1.75rem] leading-tight md:text-[2.25rem]">{title}</h2>
          <p class="text-blue-200 mt-3 text-lg">{text}</p>
        </div>
        <ContactButtons topic={topic} class="flex shrink-0 flex-col gap-3 sm:flex-row" />
      </div>
    </div>
  </section>
</div>
