---
import { services } from "../data/services";
import { site, pageUrl, fullAddress, emailParts } from "../data/site";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-blue-950 text-blue-300">
  <div class="wrap grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr] lg:py-20">
    <div>
      <!-- The name in text: the logo only works on light backgrounds, and the header already carries it.
           The tight line height puts its baseline on the column headings. -->
      <a href={pageUrl(locale)} class="font-display block text-2xl leading-[1.25rem] font-semibold text-white">
        {site.name}
      </a>
      <p class="mt-5 max-w-xs text-[0.9375rem] leading-relaxed">
        Road freight and forwarding from Dunakeszi, Hungary. GDP certified and ISO 9001:2015 certified.
      </p>
    </div>

    <div>
      <h2 class="mb-4 text-base font-semibold text-white">Services</h2>
      <ul class="space-y-2.5 text-[0.9375rem]">
        {
          services.map((s) => (
            <li>
              <a href={pageUrl(locale, `services/${s.slug}`)} class="hover:text-white">
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="mb-4 text-base font-semibold text-white">Company</h2>
      <ul class="space-y-2.5 text-[0.9375rem]">
        <li><a href={pageUrl(locale, "about")} class="hover:text-white">About us</a></li>
        <li><a href={pageUrl(locale, "fleet")} class="hover:text-white">Our fleet</a></li>
        <li><a href={pageUrl(locale, "certificates")} class="hover:text-white">Certificates</a></li>
        <li><a href={pageUrl(locale, "contact")} class="hover:text-white">Contact</a></li>
        <li><a href={pageUrl(locale, "privacy-policy")} class="hover:text-white">Privacy policy</a></li>
      </ul>
    </div>

    <div>
      <h2 class="mb-4 text-base font-semibold text-white">Contact</h2>
      <ul class="space-y-2.5 text-[0.9375rem]">
        <li><a href={site.phoneHref} class="tnum hover:text-white">{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="hover:text-white">{emailParts[0]}<wbr />{emailParts[1]}</a></li>
        <li>
          <a href={site.mapsLink} class="hover:text-white" target="_blank" rel="noopener">
            {fullAddress}, {site.address.country}
          </a>
        </li>
        <li>Office: {site.hours}</li>
        <li>Dispatch: 24 hours a day</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-2 py-6 text-sm sm:flex-row sm:justify-between">
      <p>© {year} {site.legalName} All rights reserved.</p>
      <p>Company registration number {site.registrationNumber}</p>
    </div>
  </div>
</footer>
