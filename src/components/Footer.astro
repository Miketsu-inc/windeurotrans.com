---
import { site, fullAddress, emailParts } from "../data/site";
import { format, getDictionary, getLocale, localizedPath } from "../i18n";
import { getServices } from "../i18n/content";

const locale = getLocale(Astro);
const t = getDictionary(locale);
const services = await getServices(locale);

const company = [
  { label: t.footer.aboutUs, path: "about" },
  { label: t.footer.fleet, path: "fleet" },
  { label: t.footer.certificates, path: "certificates" },
  { label: t.footer.contact, path: "contact" },
  { label: t.footer.privacy, path: "privacy-policy" },
];
---

<footer class="bg-blue-950 text-blue-300">
  <div class="wrap grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr] lg:py-20">
    <div>
      <!-- The tight line height lines the name up with the column headings -->
      <a href={localizedPath(locale)} class="block text-2xl leading-5 font-semibold text-white">{site.name}</a>
      <p class="mt-5 max-w-xs text-[0.9375rem] leading-relaxed">{t.footer.about}</p>
    </div>

    <nav aria-labelledby="footer-services">
      <h2 id="footer-services" class="mb-4 text-base font-semibold text-white">{t.footer.services}</h2>
      <ul class="space-y-2.5 text-[0.9375rem]">
        {
          services.map((s) => (
            <li>
              <a href={localizedPath(locale, `services/${s.slug}`)} class="hover:text-white">
                {s.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-company">
      <h2 id="footer-company" class="mb-4 text-base font-semibold text-white">{t.footer.company}</h2>
      <ul class="space-y-2.5 text-[0.9375rem]">
        {
          company.map((item) => (
            <li>
              <a href={localizedPath(locale, item.path)} class="hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="mb-4 text-base font-semibold text-white">{t.footer.contact}</h2>
      <ul class="space-y-2.5 text-[0.9375rem]">
        <li><a href={site.phoneHref} class="tnum hover:text-white">{site.phone}</a></li>
        <li>
          <a href={site.emailHref} class="hover:text-white">{emailParts[0]}<wbr />{emailParts[1]}</a>
        </li>
        <li>
          <a href={site.mapsLink} class="hover:text-white" target="_blank" rel="noopener">
            {fullAddress}, {t.common.country}
            <span class="sr-only">{t.meta.newTab}</span>
          </a>
        </li>
        <li>{format(t.footer.office, { hours: t.common.hours })}</li>
        <li>{t.footer.dispatch}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-2 py-6 text-sm sm:flex-row sm:justify-between">
      <p>{format(t.footer.rights, { year: new Date().getFullYear(), name: site.legalName })}</p>
      <p>{format(t.footer.registration, { number: site.registrationNumber })}</p>
    </div>
  </div>
</footer>
