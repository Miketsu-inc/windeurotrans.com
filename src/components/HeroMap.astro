---
/*
  Hero graphic: a dot-grid map of Europe with the motorway corridors we drive
  from our Dunakeszi hub. The map fades out in a circle so it sits in the
  background; on desktop, hovering a destination brightens its road.
*/
import { mapSize, hub, landDots, hungaryDots, borders, hungaryOutline, network, routes } from "../data/europe-map";

const { width: W, height: H } = mapSize;

// Routes in the data start on a small ring around the hub; run them into the hub itself
const fromHub = (d: string) => `M${hub.x} ${hub.y}L${d.slice(1)}`;
const trunks = [...new Set(Object.values(routes).map((r) => r.d.slice(1).split("L")[0]))];
const roadNetwork = trunks.map((start) => `M${hub.x} ${hub.y}L${start}`).join("") + network;

const list = Object.values(routes).map((r) => {
  // Labels sit on the far side of the city, away from the hub
  const dx = r.x - hub.x;
  const dy = r.y - hub.y;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  return {
    ...r,
    d: fromHub(r.d),
    label: {
      x: r.x + ux * 16,
      y: r.y + uy * 16 + (uy < -0.4 ? -6 : uy > 0.4 ? 20 : 8),
      anchor: Math.abs(ux) < 0.4 ? "middle" : ux < 0 ? "end" : "start",
    },
  };
});
---

<div class="hero-map" data-hero-map>
  <svg viewBox={`0 0 ${W} ${H}`} class="block h-auto w-full overflow-visible" aria-hidden="true">
    <defs>
      <radialGradient id="hm-fade" gradientUnits="userSpaceOnUse" cx={W / 2} cy={H / 2} r={W / 2}>
        <stop offset="0.45" stop-color="#fff" />
        <stop offset="0.72" stop-color="#b0b0b0" />
        <stop offset="0.9" stop-color="#3a3a3a" />
        <stop offset="1" stop-color="#000" />
      </radialGradient>
      <mask id="hm-edge" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
        <rect width={W} height={H} fill="url(#hm-fade)" />
      </mask>
      <radialGradient id="hm-spot">
        <stop offset="0" stop-color="#fff" />
        <stop offset="1" stop-color="#000" />
      </radialGradient>
      <mask id="hm-spotlight" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
        <circle r="0" fill="url(#hm-spot)" data-spot />
      </mask>
    </defs>

    <g mask="url(#hm-edge)">
      <path d={landDots} class="hero-map__land" />
      <path d={landDots} class="hero-map__land hero-map__land--lit" mask="url(#hm-spotlight)" />
      <path d={borders} class="hero-map__borders" />
    </g>
    <path d={hungaryOutline} class="hero-map__hu-outline" />
    <path d={hungaryDots} class="hero-map__hu" />

    <!-- The road network, drawn once so shared motorways don't double up -->
    <path d={roadNetwork} class="hero-map__network" />

    {
      list.map((r, i) => (
        <g class="hero-map__route" data-route={i} style={`--i:${i}`}>
          <path d={r.d} pathLength="100" class="hero-map__road" />
          <path d={r.d} pathLength="100" class="hero-map__truck" />
          <circle cx={r.x} cy={r.y} r="4.5" class="hero-map__stop" />
          <text x={r.label.x} y={r.label.y} text-anchor={r.label.anchor} class="hero-map__name">
            {r.name}
          </text>
          <circle cx={r.x} cy={r.y} r="30" class="hero-map__hit" data-hit={i} />
        </g>
      ))
    }

    <circle cx={hub.x} cy={hub.y} r="7" class="hero-map__hub" />
    <text x={hub.x + 22} y={hub.y + 40} class="hero-map__hub-label">{hub.name}</text>
  </svg>
</div>

<style>
  .hero-map__land {
    fill: none;
    stroke: #cbd7e8;
    stroke-width: 4.8;
    stroke-linecap: round;
  }
  .hero-map__land--lit {
    stroke: #a8bddb;
  }
  .hero-map__borders {
    fill: none;
    stroke: #b4c5dd;
    stroke-width: 0.8;
    stroke-linejoin: round;
    opacity: 0.8;
  }
  .hero-map__hu {
    fill: none;
    stroke: var(--color-signal);
    stroke-width: 4.8;
    stroke-linecap: round;
  }
  .hero-map__hu-outline {
    fill: rgb(253 74 1 / 0.1);
    stroke: var(--color-signal);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  /* Roads */
  .hero-map__network,
  .hero-map__road,
  .hero-map__truck {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero-map__network {
    stroke: var(--color-blue-900);
    stroke-width: 1.6;
    stroke-opacity: 0.35;
    opacity: 0;
    animation: hm-in 1.2s ease 0.2s forwards;
    transition: stroke-opacity 0.3s ease;
  }
  /* Per-route copy, only visible when its destination is hovered */
  .hero-map__road {
    stroke: var(--color-blue-900);
    stroke-width: 2;
    stroke-opacity: 0;
    transition: stroke-opacity 0.3s ease;
  }
  /* A single dot travelling slowly along each road */
  .hero-map__truck {
    stroke: var(--color-signal);
    stroke-width: 4.5;
    stroke-dasharray: 0 100;
    opacity: 0;
    animation:
      hm-in 0.4s ease forwards,
      hm-drive 9s linear infinite;
    animation-delay: calc(1.4s + var(--i) * 0.9s);
  }
  .hero-map__stop {
    fill: var(--color-blue-900);
    stroke: var(--color-frost);
    stroke-width: 2.5;
    opacity: 0;
    animation: hm-in 0.4s ease forwards;
    animation-delay: calc(0.9s + var(--i) * 0.06s);
    transition: fill 0.3s ease;
  }
  .hero-map__name {
    fill: var(--color-ink);
    fill-opacity: 0.8;
    font-size: 23px;
    font-weight: 500;
    opacity: 0;
    paint-order: stroke;
    stroke: var(--color-frost);
    stroke-width: 8px;
    stroke-linejoin: round;
    animation: hm-in 0.5s ease forwards;
    animation-delay: 1.1s;
    transition: fill-opacity 0.3s ease;
  }
  .hero-map__hit {
    fill: transparent;
  }

  /* Hover: the chosen road brightens a little, the rest of the network steps back a little */
  .hero-map.has-active .hero-map__network {
    stroke-opacity: 0.2;
  }
  .hero-map__route.is-active .hero-map__road {
    stroke-opacity: 1;
  }
  .hero-map__route.is-active .hero-map__stop {
    fill: var(--color-signal);
  }
  .hero-map__route.is-active .hero-map__name {
    fill-opacity: 1;
  }

  /* Hub */
  .hero-map__hub {
    fill: var(--color-blue-900);
  }
  .hero-map__hub-label {
    fill: var(--color-ink);
    font-size: 25px;
    font-weight: 600;
    paint-order: stroke;
    stroke: var(--color-frost);
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  @keyframes hm-drive {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -100;
    }
  }
  @keyframes hm-in {
    to {
      opacity: 1;
    }
  }

  /* Small screens: city names would be too small to read */
  @media (max-width: 639px) {
    .hero-map__name {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-map__network,
    .hero-map__stop,
    .hero-map__name {
      animation: none;
      opacity: 1;
    }
    .hero-map__truck {
      display: none;
    }
  }
</style>

<script>
  // Hover only: on touch screens the map is decoration
  if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    document.querySelectorAll<HTMLElement>("[data-hero-map]").forEach((root) => {
      const groups = root.querySelectorAll<SVGGElement>("[data-route]");
      const svg = root.querySelector("svg")!;
      const spot = root.querySelector<SVGCircleElement>("[data-spot]")!;

      root.querySelectorAll<SVGCircleElement>("[data-hit]").forEach((hit) => {
        hit.addEventListener("pointerenter", () => {
          const i = Number(hit.dataset.hit);
          root.classList.add("has-active");
          groups.forEach((g, j) => g.classList.toggle("is-active", i === j));
        });
        hit.addEventListener("pointerleave", () => {
          root.classList.remove("has-active");
          groups.forEach((g) => g.classList.remove("is-active"));
        });
      });

      // A faint glow on the dots around the cursor
      const pt = svg.createSVGPoint();
      svg.addEventListener("pointermove", (e) => {
        pt.x = e.clientX;
        pt.y = e.clientY;
        const p = pt.matrixTransform(svg.getScreenCTM()!.inverse());
        spot.setAttribute("cx", String(p.x));
        spot.setAttribute("cy", String(p.y));
        spot.setAttribute("r", "90");
      });
      svg.addEventListener("pointerleave", () => spot.setAttribute("r", "0"));
    });
  }
</script>
