---
/*
  Masthead shared by every subpage: a night band under the white header,
  with breadcrumbs, the page title and an optional intro and actions.
*/
import { pageUrl } from "../data/site";

interface Props {
  locale: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
}

const { locale, title, lead, crumbs = [] } = Astro.props;
const trail = [{ label: "Home", href: pageUrl(locale) }, ...crumbs];
---

<section class="band-night">
  <div class="wrap pt-8 pb-14 md:pt-10 md:pb-20">
    <nav aria-label="Breadcrumb">
      <ol class="text-blue-300 flex flex-wrap items-center gap-x-2 text-sm">
        {
          trail.map((c, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <span aria-hidden="true">/</span>}
              {c.href ? (
                <a href={c.href} class="hover:text-white">
                  {c.label}
                </a>
              ) : (
                <span aria-current="page" class="text-blue-200">{c.label}</span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
      <div class="max-w-3xl">
        <h1 class="text-[2.5rem] leading-[1.05] md:text-[3.5rem]">{title}</h1>
        {lead && <p class="text-blue-200 mt-5 max-w-2xl text-lg md:text-xl md:leading-relaxed">{lead}</p>}
      </div>
      <slot />
    </div>
  </div>
</section>
