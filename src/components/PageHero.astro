---
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<section class="band-night">
  <div class="wrap pt-12 pb-14 md:pt-16 md:pb-20">
    <h1 class="max-w-3xl text-[2.5rem] leading-[1.05] md:text-[3.5rem]">{title}</h1>
    {lead && <p class="mt-5 max-w-2xl text-lg text-blue-200 md:text-xl md:leading-relaxed">{lead}</p>}
  </div>
</section>
