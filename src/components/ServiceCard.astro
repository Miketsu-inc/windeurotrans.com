---
/*
  A service as a clickable card: photo, name and one line.
  Hover: the card lifts (like every card link) and "Read more" takes the orange underline links use.
  The compact version (photo and name only) previews other services under an article.
*/
import type { Service } from "../data/services";
import { pageUrl } from "../data/site";
import { photoSrc, photoSrcset } from "../data/fleet";

interface Props {
  service: Service;
  locale: string;
  /** Load the photo straight away (cards in the first screen). */
  eager?: boolean;
  /** Photo and name only, with an h3 title. */
  compact?: boolean;
}

const { service: s, locale, eager = false, compact = false } = Astro.props;
const Heading = compact ? "h3" : "h2";
---

<a
  href={pageUrl(locale, `services/${s.slug}`)}
  class="card group flex h-full flex-col overflow-hidden"
>
  <img
    src={photoSrc(s.image.photo)}
    srcset={photoSrcset(s.image.photo)}
    sizes={compact ? "(min-width: 1024px) 300px, (min-width: 640px) 50vw, 100vw" : "(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"}
    alt={s.image.alt}
    width="800"
    height="533"
    loading={eager ? "eager" : "lazy"}
    class="aspect-[3/2] w-full object-cover"
    style={s.image.position && `object-position: ${s.image.position}`}
  />
  <div class:list={["flex grow flex-col", compact ? "p-5" : "p-6 md:p-7"]}>
    <Heading
      class:list={[
        "leading-snug",
        compact ? "text-lg" : "text-xl md:text-[1.375rem]",
      ]}
    >
      {s.name}
    </Heading>
    {!compact && <p class="text-muted mt-2">{s.short}</p>}
    <span class:list={["mt-auto self-start", compact ? "pt-4" : "pt-6"]}>
      <span class="link group-hover:decoration-signal">Read more</span>
    </span>
  </div>
</a>
