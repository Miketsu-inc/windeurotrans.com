---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import logo from "../assets/logo.svg";
import { site } from "../data/site";
import { format, getDictionary, getLocale, languageNames, locales, localizedPath, pagePath } from "../i18n";
import { getServices } from "../i18n/content";

const locale = getLocale(Astro);
const t = getDictionary(locale);
const services = await getServices(locale);
const currentPath = pagePath(Astro.url);

const languages = locales.map((code) => ({ code, label: languageNames[code], url: localizedPath(code, currentPath) }));

const nav = [
  { label: t.nav.fleet, path: "fleet" },
  { label: t.nav.certificates, path: "certificates" },
  { label: t.nav.about, path: "about" },
];
const isCurrent = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
---

<header id="site-header" class="text-ink bg-frost sticky top-0 z-50 border-b border-transparent transition-colors">
  <div class="wrap flex h-16 items-center gap-6 lg:h-18">
    <a href={localizedPath(locale)} class="mr-auto shrink-0 lg:mr-4">
      <Image src={logo} alt={format(t.nav.home, { name: site.name })} class="h-11 w-auto lg:h-14" loading="eager" />
    </a>

    <nav aria-label={t.nav.main} class="hidden font-medium lg:block">
      <ul class="flex items-center gap-1">
        <li class="relative" data-dropdown>
          <div class="nav-item flex items-center">
            <a
              href={localizedPath(locale, "services")}
              class:list={["nav-link py-2 pl-3", isCurrent("services") && "nav-current"]}
              aria-current={currentPath === "services" ? "page" : undefined}
            >
              {t.nav.services}
            </a>
            <button
              type="button"
              class="py-2 pr-2.5 pl-1"
              aria-label={t.nav.showServices}
              aria-expanded="false"
              aria-controls="services-menu"
              data-dropdown-trigger
            >
              <Icon name="chevron" class="size-4 transition-transform" />
            </button>
          </div>
          <ul id="services-menu" class="dropdown-panel left-0 w-88" data-dropdown-panel>
            {
              services.map((s) => (
                <li>
                  <a
                    href={localizedPath(locale, `services/${s.slug}`)}
                    class:list={["nav-item block px-3 py-2.5", currentPath === `services/${s.slug}` && "is-current"]}
                    aria-current={currentPath === `services/${s.slug}` ? "page" : undefined}
                  >
                    <span class="nav-link font-semibold">{s.data.name}</span>
                    <span class="text-muted block text-sm">{s.data.tagline}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          nav.map((item) => (
            <li>
              <a
                href={localizedPath(locale, item.path)}
                class:list={["nav-item nav-link block px-3 py-2", isCurrent(item.path) && "nav-current"]}
                aria-current={isCurrent(item.path) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto hidden items-center gap-2 font-medium lg:flex">
      <a href={site.phoneHref} class="nav-item tnum flex items-center gap-2 px-3 py-2">
        <Icon name="phone" class="text-signal size-4.5" />
        <span class="nav-link">{site.phone}</span>
      </a>

      <div class="relative" data-dropdown>
        <button
          type="button"
          class="nav-item flex cursor-pointer items-center gap-1.5 px-3 py-2"
          aria-expanded="false"
          aria-controls="lang-menu"
          data-dropdown-trigger
        >
          <Icon name="globe" class="size-4.5" />
          <span class="nav-link">{locale.toUpperCase()}</span>
          <span class="sr-only">{t.nav.changeLanguage}</span>
        </button>
        <ul id="lang-menu" class="dropdown-panel right-0 w-40" data-dropdown-panel>
          {
            languages.map((l) => (
              <li>
                <a
                  href={l.url}
                  lang={l.code}
                  hreflang={l.code}
                  class:list={["nav-item block px-3 py-2", l.code === locale && "is-current font-semibold"]}
                  aria-current={l.code === locale ? "true" : undefined}
                >
                  <span class="nav-link">{l.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <a href={localizedPath(locale, "contact")} class="btn btn-signal ml-2 h-11 min-h-0 rounded-md px-3.5 py-0">
        {t.nav.contactUs}
      </a>
    </div>

    <button
      type="button"
      class="-mr-2 rounded-md p-2 lg:hidden"
      aria-label={t.nav.openMenu}
      aria-haspopup="dialog"
      aria-controls="mobile-menu"
      data-menu-open
    >
      <Icon name="menu" class="size-7" />
    </button>
  </div>

  <dialog
    id="mobile-menu"
    class="text-ink bg-frost m-0 h-dvh max-h-none w-full max-w-none flex-col overflow-y-auto p-0 open:flex lg:hidden"
    aria-label={t.nav.menu}
  >
    <div class="wrap border-line flex h-16.25 shrink-0 items-center justify-between border-b">
      <Image src={logo} alt="" class="h-11 w-auto" />
      <button type="button" class="-mr-2 rounded-md p-2" aria-label={t.nav.closeMenu} data-menu-close>
        <Icon name="close" class="size-7" />
      </button>
    </div>
    <nav aria-label={t.nav.main} class="wrap flex grow flex-col pt-4 pb-8">
      <a href={localizedPath(locale, "services")} class="block py-2 text-2xl font-semibold">{t.nav.services}</a>
      <ul class="pb-3">
        {
          services.map((s) => (
            <li>
              <a href={localizedPath(locale, `services/${s.slug}`)} class="text-muted block py-1.5 pl-4 text-lg">
                {s.data.name}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="pb-8">
        {
          [...nav, { label: t.nav.contact, path: "contact" }].map((item) => (
            <li>
              <a href={localizedPath(locale, item.path)} class="block py-2 text-2xl font-semibold">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mt-auto flex gap-2" aria-label={t.nav.language}>
        {
          languages.map((l) => (
            <li>
              <a
                href={l.url}
                lang={l.code}
                hreflang={l.code}
                class:list={[
                  "block rounded-md border px-3 py-1.5 text-sm",
                  l.code === locale ? "border-blue-900 text-blue-900" : "border-line text-muted",
                ]}
                aria-current={l.code === locale ? "true" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </dialog>
</header>

<style>
  .dropdown-panel {
    position: absolute;
    top: 100%;
    margin-top: 0.5rem;
    padding: 0.375rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: 0 18px 40px -16px rgb(0 36 97 / 0.25);
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 0.15s,
      visibility 0.15s;
  }
  [data-dropdown].is-open .dropdown-panel {
    visibility: visible;
    opacity: 1;
  }
  [data-dropdown].is-open [data-dropdown-trigger] :global(svg) {
    transform: rotate(180deg);
  }

  .nav-item {
    border-radius: 0.375rem;
    transition: background-color 0.15s ease;
  }
  .dropdown-panel .nav-item {
    border-radius: 0.5rem;
  }
  .nav-item:hover,
  [data-dropdown].is-open > .nav-item {
    background-color: rgb(0 0 0 / 0.05);
  }

  /* The current page is marked with an orange underline */
  .nav-link {
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: transparent;
    text-underline-offset: 0.45em;
  }
  .dropdown-panel .nav-link {
    text-underline-offset: 0.3em;
  }
  .is-current .nav-link,
  .nav-current {
    text-decoration-color: var(--color-signal);
  }

  #site-header.is-scrolled {
    border-color: var(--color-line);
  }

  /* The open menu hides the page's scrollbar; fill the gap it leaves with the menu's colour */
  :global(html:has(#mobile-menu[open])) {
    background: var(--color-frost);
  }
</style>

<script>
  const dropdowns = document.querySelectorAll<HTMLElement>("[data-dropdown]");
  const canHover = window.matchMedia("(hover: hover)");

  function setOpen(dropdown: HTMLElement, open: boolean) {
    dropdown.classList.toggle("is-open", open);
    dropdown.querySelector("[data-dropdown-trigger]")?.setAttribute("aria-expanded", String(open));
  }

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLElement>("[data-dropdown-trigger]")!;
    let closeTimer: number | undefined;

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = !dropdown.classList.contains("is-open");
      dropdowns.forEach((d) => d !== dropdown && setOpen(d, false));
      setOpen(dropdown, open);
    });

    dropdown.addEventListener("mouseenter", () => {
      if (!canHover.matches) return;
      window.clearTimeout(closeTimer);
      dropdowns.forEach((d) => d !== dropdown && setOpen(d, false));
      setOpen(dropdown, true);
    });
    dropdown.addEventListener("mouseleave", () => {
      if (!canHover.matches) return;
      closeTimer = window.setTimeout(() => setOpen(dropdown, false), 150);
    });
    dropdown.addEventListener("focusout", (e) => {
      if (!dropdown.contains(e.relatedTarget as Node)) setOpen(dropdown, false);
    });
  });

  document.addEventListener("click", () => dropdowns.forEach((d) => setOpen(d, false)));
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    dropdowns.forEach((d) => {
      if (!d.classList.contains("is-open")) return;
      setOpen(d, false);
      d.querySelector<HTMLElement>("[data-dropdown-trigger]")?.focus();
    });
  });

  const header = document.getElementById("site-header")!;
  const updateHeader = () => header.classList.toggle("is-scrolled", window.scrollY > 4);
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu")!;
  document.querySelector("[data-menu-open]")!.addEventListener("click", () => {
    menu.showModal();
    document.body.style.overflow = "hidden";
  });
  document.querySelector("[data-menu-close]")!.addEventListener("click", () => menu.close());
  menu.addEventListener("close", () => (document.body.style.overflow = ""));
  // The menu is for small screens only: close it if the window grows to desktop width
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => e.matches && menu.close());
</script>
