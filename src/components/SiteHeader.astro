---
import Icon from "./Icon.astro";
import { services } from "../data/services";
import { site, asset, pageUrl } from "../data/site";

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const languages = [
  { code: "hu", label: "Magyar" },
  { code: "en", label: "English" },
  { code: "it", label: "Italiano" },
];

// Current path without the base and the locale, so the language switcher stays on the same page
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
let path = Astro.url.pathname;
if (path.startsWith(base)) path = path.slice(base.length);
const parts = path.split("/").filter(Boolean);
if (languages.some((l) => l.code === parts[0])) parts.shift();
const currentPath = parts.join("/");

const langUrls = languages.map((l) => ({
  ...l,
  url: pageUrl(l.code, currentPath),
}));

const nav = [
  { label: "Fleet", href: pageUrl(locale, "fleet"), match: "fleet" },
  {
    label: "Certificates",
    href: pageUrl(locale, "certificates"),
    match: "certificates",
  },
  { label: "About us", href: pageUrl(locale, "about"), match: "about" },
  { label: "Contact", href: pageUrl(locale, "contact"), match: "contact" },
];

const isServices = currentPath.startsWith("services");
---

<header
  id="site-header"
  class="text-ink sticky top-0 z-50 bg-frost border-b border-transparent transition-colors"
>
  <div class="wrap flex h-16 lg:h-18 items-center gap-6">
    <a
      href={pageUrl(locale)}
      class="mr-auto shrink-0 lg:mr-4"
      aria-label={`${site.name} home`}
    >
      <img
        src={asset("logo.svg")}
        alt=""
        width="1711"
        height="740"
        class="h-11 w-auto lg:h-14"
      />
    </a>

    <nav aria-label="Main" class="hidden font-medium lg:block">
      <ul class="flex items-center gap-1">
        <!-- "Services" goes to the services page; hovering it (or the chevron button) lists the services -->
        <li class="relative" data-dropdown>
          <div class="nav-item flex items-center">
            <a
              href={pageUrl(locale, "services")}
              class:list={["nav-link py-2 pl-3", isServices && "nav-current"]}
              aria-current={currentPath === "services" ? "page" : undefined}
            >
              Services
            </a>
            <button
              type="button"
              class="py-2 pr-2.5 pl-1"
              aria-label="Show services"
              aria-expanded="false"
              aria-controls="services-menu"
              data-dropdown-trigger
            >
              <Icon name="chevron" class="size-4 transition-transform" />
            </button>
          </div>
          <ul
            id="services-menu"
            class="text-ink invisible absolute top-full left-0 mt-2 w-[22rem] border-line rounded-xl border bg-white p-1.5 opacity-0 shadow-[0_18px_40px_-16px_rgb(0_36_97/0.25)] transition-[opacity,visibility] duration-150"
            data-dropdown-panel
          >
            {
              services.map((s) => (
                <li>
                  <a
                    href={pageUrl(locale, `services/${s.slug}`)}
                    class:list={[
                      "nav-item block rounded-lg px-3 py-2.5",
                      currentPath === `services/${s.slug}` && "is-current",
                    ]}
                    aria-current={
                      currentPath === `services/${s.slug}` ? "page" : undefined
                    }
                  >
                    <span class="nav-link font-semibold">{s.name}</span>
                    <span class="text-muted block text-sm">{s.tagline}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          nav
            .filter((item) => item.match !== "contact")
            .map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "nav-item nav-link block px-3 py-2",
                    currentPath.startsWith(item.match) && "nav-current",
                  ]}
                  aria-current={
                    currentPath.startsWith(item.match) ? "page" : undefined
                  }
                >
                  {item.label}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>

    <div class="ml-auto hidden items-center gap-2 font-medium lg:flex">
      <a
        href={site.phoneHref}
        class="nav-item tnum flex items-center gap-2 px-3 py-2"
      >
        <Icon name="phone" class="text-signal size-4.5" />
        <span class="nav-link">{site.phone}</span>
      </a>

      <div class="relative" data-dropdown>
        <button
          type="button"
          class="nav-item flex cursor-pointer items-center gap-1.5 px-3 py-2"
          aria-expanded="false"
          aria-controls="lang-menu"
          aria-label="Change language"
          data-dropdown-trigger
        >
          <Icon name="globe" class="size-4.5" />
          <span class="nav-link">{locale.toUpperCase()}</span>
        </button>
        <ul
          id="lang-menu"
          class="text-ink invisible absolute top-full right-0 mt-2 w-40 border-line rounded-xl border bg-white p-1.5 opacity-0 shadow-[0_18px_40px_-16px_rgb(0_36_97/0.25)] transition-[opacity,visibility] duration-150"
          data-dropdown-panel
        >
          {
            langUrls.map((l) => (
              <li>
                <a
                  href={l.url}
                  lang={l.code}
                  class:list={[
                    "nav-item block rounded-lg px-3 py-2",
                    l.code === locale && "is-current font-semibold",
                  ]}
                  aria-current={l.code === locale ? "true" : undefined}
                >
                  <span class="nav-link">{l.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <a
        href={pageUrl(locale, "contact")}
        class="btn btn-signal ml-2 min-h-0 h-11 rounded-md px-3.5 py-0"
        >Contact us</a
      >
    </div>

    <button
      type="button"
      id="menu-open"
      class="-mr-2 rounded-md p-2 lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="size-7" />
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="text-ink bg-frost fixed inset-0 z-50 hidden flex-col overflow-y-auto lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
  >
    <div
      class="wrap border-line flex h-[calc(4rem+1px)] shrink-0 items-center justify-between border-b"
    >
      <img
        src={asset("logo.svg")}
        alt={site.name}
        width="1711"
        height="740"
        class="h-11 w-auto"
      />
      <button
        type="button"
        id="menu-close"
        class="-mr-2 rounded-md p-2"
        aria-label="Close menu"
      >
        <Icon name="close" class="size-7" />
      </button>
    </div>
    <nav aria-label="Mobile" class="wrap flex grow flex-col pt-4 pb-8">
      <a
        href={pageUrl(locale, "services")}
        class="font-display block py-2 text-2xl font-semibold">Services</a
      >
      <ul class="pb-3">
        {
          services.map((s) => (
            <li>
              <a
                href={pageUrl(locale, `services/${s.slug}`)}
                class="text-muted block py-1.5 pl-4 text-lg"
              >
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="pb-8">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-display block py-2 text-2xl font-semibold"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-auto">
        <div class="flex gap-2" aria-label="Language">
          {
            langUrls.map((l) => (
              <a
                href={l.url}
                lang={l.code}
                class:list={[
                  "rounded-md border px-3 py-1.5 text-sm",
                  l.code === locale
                    ? "border-blue-900 text-blue-900"
                    : "border-line text-muted",
                ]}
                aria-current={l.code === locale ? "true" : undefined}
              >
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Hover: a light neutral grey behind the item; the text stays dark */
  .nav-item {
    border-radius: 0.375rem;
    transition: background-color 0.15s ease;
  }
  [data-dropdown-panel] .nav-item {
    border-radius: 0.5rem;
  }
  .nav-item:hover,
  [data-dropdown].is-open > .nav-item {
    background-color: rgb(0 0 0 / 0.05);
  }

  /* Current page: orange underline under the text (orange text on white is too faint to read) */
  .nav-link {
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: transparent;
    text-underline-offset: 0.45em;
  }
  [data-dropdown-panel] .nav-link {
    text-underline-offset: 0.3em;
  }
  .is-current .nav-link,
  .nav-current {
    text-decoration-color: var(--color-signal);
  }
  /* No line under the header at the top of the page, so it runs into the white hero; it appears once you scroll */
  #site-header.is-scrolled {
    border-color: var(--color-line);
  }
  [data-dropdown].is-open [data-dropdown-panel] {
    visibility: visible;
    opacity: 1;
  }
  [data-dropdown].is-open [data-dropdown-trigger] :global(svg) {
    transform: rotate(180deg);
  }
  @media (max-width: 1023px) {
    #mobile-menu.is-open {
      display: flex;
    }
  }
  /* While the menu is open the page can't scroll, so its scrollbar goes. Paint the space it leaves white, like the menu. */
  :global(html:has(#mobile-menu.is-open)) {
    background: var(--color-frost);
  }
</style>

<script>
  // Dropdowns: open on click or hover, close on outside click and Escape
  const dropdowns = document.querySelectorAll<HTMLElement>("[data-dropdown]");

  function setOpen(dropdown: HTMLElement, open: boolean) {
    dropdown.classList.toggle("is-open", open);
    dropdown
      .querySelector("[data-dropdown-trigger]")
      ?.setAttribute("aria-expanded", String(open));
  }

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLElement>(
      "[data-dropdown-trigger]",
    )!;
    let closeTimer: number | undefined;

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = !dropdown.classList.contains("is-open");
      dropdowns.forEach((d) => d !== dropdown && setOpen(d, false));
      setOpen(dropdown, open);
    });

    dropdown.addEventListener("mouseenter", () => {
      if (!window.matchMedia("(hover: hover)").matches) return;
      window.clearTimeout(closeTimer);
      dropdowns.forEach((d) => d !== dropdown && setOpen(d, false));
      setOpen(dropdown, true);
    });
    dropdown.addEventListener("mouseleave", () => {
      if (!window.matchMedia("(hover: hover)").matches) return;
      closeTimer = window.setTimeout(() => setOpen(dropdown, false), 150);
    });
    dropdown.addEventListener("focusout", (e) => {
      if (!dropdown.contains(e.relatedTarget as Node)) setOpen(dropdown, false);
    });
  });

  document.addEventListener("click", () =>
    dropdowns.forEach((d) => setOpen(d, false)),
  );
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    dropdowns.forEach((d) => {
      if (d.classList.contains("is-open")) {
        setOpen(d, false);
        d.querySelector<HTMLElement>("[data-dropdown-trigger]")?.focus();
      }
    });
    if (menu.classList.contains("is-open")) closeMenu();
  });

  // Header line: only once the page has scrolled
  const header = document.getElementById("site-header")!;
  const updateHeader = () =>
    header.classList.toggle("is-scrolled", window.scrollY > 4);
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  // Mobile menu
  const menu = document.getElementById("mobile-menu")!;
  const openBtn = document.getElementById("menu-open")!;
  const closeBtn = document.getElementById("menu-close")!;

  function openMenu() {
    menu.classList.add("is-open");
    openBtn.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    closeBtn.focus();
  }
  function closeMenu() {
    menu.classList.remove("is-open");
    openBtn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    openBtn.focus();
  }

  openBtn.addEventListener("click", openMenu);
  closeBtn.addEventListener("click", closeMenu);
</script>
