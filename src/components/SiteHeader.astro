---
import Icon from "./Icon.astro";
import { services } from "../data/services";
import { site, pageUrl, mailto } from "../data/site";

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const languages = [
  { code: "hu", label: "Magyar" },
  { code: "en", label: "English" },
  { code: "it", label: "Italiano" },
];

// Current path without the base and the locale, so the language switcher stays on the same page
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
let path = Astro.url.pathname;
if (path.startsWith(base)) path = path.slice(base.length);
const parts = path.split("/").filter(Boolean);
if (languages.some((l) => l.code === parts[0])) parts.shift();
const currentPath = parts.join("/");

const langUrls = languages.map((l) => ({ ...l, url: pageUrl(l.code, currentPath) }));

const nav = [
  { label: "Certificates", href: pageUrl(locale, "certificates"), match: "certificates" },
  { label: "About us", href: pageUrl(locale, "about"), match: "about" },
  { label: "Contact", href: pageUrl(locale, "contact"), match: "contact" },
];

const isServices = currentPath.startsWith("services");
---

<header id="site-header" class="bg-navy-900 sticky top-0 z-50 text-white">
  <div class="wrap flex h-[4.5rem] items-center gap-6">
    <a href={pageUrl(locale)} class="mr-auto flex items-center gap-2.5 lg:mr-4" aria-label={`${site.name} home`}>
      <!-- Placeholder wordmark until the new logo arrives -->
      <span class="bg-signal block h-7 w-2 rounded-sm" aria-hidden="true"></span>
      <span class="text-xl leading-none font-semibold tracking-tight">Wind Eurotrans</span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        <!-- "Services" goes to the services page; hovering it (or the chevron button) lists the services -->
        <li class="relative" data-dropdown>
          <div class="flex items-center rounded-md hover:bg-white/8">
            <a
              href={pageUrl(locale, "services")}
              class:list={["py-2 pl-3", isServices && "text-signal"]}
              aria-current={currentPath === "services" ? "page" : undefined}
            >
              Services
            </a>
            <button
              type="button"
              class="py-2 pr-2.5 pl-1"
              aria-label="Show services"
              aria-expanded="false"
              aria-controls="services-menu"
              data-dropdown-trigger
            >
              <Icon name="chevron" class:list={["size-4 transition-transform", isServices && "text-signal"]} />
            </button>
          </div>
          <ul
            id="services-menu"
            class="text-ink invisible absolute top-full left-0 mt-2 w-[22rem] rounded-xl bg-white p-1.5 opacity-0 shadow-[0_18px_40px_-12px_rgb(7_23_41/0.45)] transition-[opacity,visibility] duration-150"
            data-dropdown-panel
          >
            {
              services.map((s) => (
                <li>
                  <a
                    href={pageUrl(locale, `services/${s.slug}`)}
                    class:list={[
                      "hover:bg-paper block rounded-lg px-3 py-2.5",
                      currentPath === `services/${s.slug}` && "bg-paper",
                    ]}
                    aria-current={currentPath === `services/${s.slug}` ? "page" : undefined}
                  >
                    <span class="block font-semibold">{s.name}</span>
                    <span class="text-muted block text-sm">{s.tagline}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          nav.filter((item) => item.match !== "contact").map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "block rounded-md px-3 py-2 hover:bg-white/8",
                  currentPath.startsWith(item.match) && "text-signal",
                ]}
                aria-current={currentPath.startsWith(item.match) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto hidden items-center gap-2 lg:flex">
      <a href={site.phoneHref} class="tnum flex items-center gap-2 rounded-md px-3 py-2 hover:bg-white/8">
        <Icon name="phone" class="text-signal size-4.5" />
        {site.phone}
      </a>

      <div class="relative" data-dropdown>
        <button
          type="button"
          class="flex items-center gap-1.5 rounded-md px-3 py-2 hover:bg-white/8"
          aria-expanded="false"
          aria-controls="lang-menu"
          aria-label="Change language"
          data-dropdown-trigger
        >
          <Icon name="globe" class="size-4.5" />
          {locale.toUpperCase()}
        </button>
        <ul
          id="lang-menu"
          class="text-ink invisible absolute top-full right-0 mt-2 w-40 rounded-xl bg-white p-1.5 opacity-0 shadow-[0_18px_40px_-12px_rgb(7_23_41/0.45)] transition-[opacity,visibility] duration-150"
          data-dropdown-panel
        >
          {
            langUrls.map((l) => (
              <li>
                <a
                  href={l.url}
                  lang={l.code}
                  class:list={["hover:bg-paper block rounded-lg px-3 py-2", l.code === locale && "font-semibold"]}
                  aria-current={l.code === locale ? "true" : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <a href={pageUrl(locale, "contact")} class="btn btn-signal ml-2">Contact us</a>
    </div>

    <button
      type="button"
      id="menu-open"
      class="-mr-2 rounded-md p-2 lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="size-7" />
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="bg-navy-900 fixed inset-0 z-50 hidden flex-col overflow-y-auto lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
  >
    <div class="wrap flex h-[4.5rem] shrink-0 items-center justify-between">
      <span class="flex items-center gap-2.5">
        <span class="bg-signal block h-7 w-2 rounded-sm" aria-hidden="true"></span>
        <span class="text-xl leading-none font-semibold tracking-tight">Wind Eurotrans</span>
      </span>
      <button type="button" id="menu-close" class="-mr-2 rounded-md p-2" aria-label="Close menu">
        <Icon name="close" class="size-7" />
      </button>
    </div>
    <nav aria-label="Mobile" class="wrap flex grow flex-col pt-4 pb-8">
      <a href={pageUrl(locale, "services")} class="block py-2 text-2xl font-medium">Services</a>
      <ul class="pb-3">
        {
          services.map((s) => (
            <li>
              <a href={pageUrl(locale, `services/${s.slug}`)} class="text-navy-200 block py-1.5 pl-4 text-lg">
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="pb-8">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="block py-2 text-2xl font-medium">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-auto flex flex-col gap-3">
        <a href={site.phoneHref} class="btn btn-signal tnum">
          <Icon name="phone" class="size-4.5" />
          Call {site.phone}
        </a>
        <a href={mailto()} class="btn btn-outline-light">
          <Icon name="mail" class="size-4.5" />
          Email us
        </a>
        <div class="mt-4 flex gap-2" aria-label="Language">
          {
            langUrls.map((l) => (
              <a
                href={l.url}
                lang={l.code}
                class:list={[
                  "rounded-md border px-3 py-1.5 text-sm",
                  l.code === locale ? "border-white" : "border-white/25 text-navy-200",
                ]}
                aria-current={l.code === locale ? "true" : undefined}
              >
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  [data-dropdown].is-open [data-dropdown-panel] {
    visibility: visible;
    opacity: 1;
  }
  [data-dropdown].is-open [data-dropdown-trigger] :global(svg) {
    transform: rotate(180deg);
  }
  @media (max-width: 1023px) {
    #mobile-menu.is-open {
      display: flex;
    }
  }
</style>

<script>
  // Dropdowns: open on click or hover, close on outside click and Escape
  const dropdowns = document.querySelectorAll<HTMLElement>("[data-dropdown]");

  function setOpen(dropdown: HTMLElement, open: boolean) {
    dropdown.classList.toggle("is-open", open);
    dropdown.querySelector("[data-dropdown-trigger]")?.setAttribute("aria-expanded", String(open));
  }

  dropdowns.forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLElement>("[data-dropdown-trigger]")!;
    let closeTimer: number | undefined;

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = !dropdown.classList.contains("is-open");
      dropdowns.forEach((d) => d !== dropdown && setOpen(d, false));
      setOpen(dropdown, open);
    });

    dropdown.addEventListener("mouseenter", () => {
      if (!window.matchMedia("(hover: hover)").matches) return;
      window.clearTimeout(closeTimer);
      dropdowns.forEach((d) => d !== dropdown && setOpen(d, false));
      setOpen(dropdown, true);
    });
    dropdown.addEventListener("mouseleave", () => {
      if (!window.matchMedia("(hover: hover)").matches) return;
      closeTimer = window.setTimeout(() => setOpen(dropdown, false), 150);
    });
    dropdown.addEventListener("focusout", (e) => {
      if (!dropdown.contains(e.relatedTarget as Node)) setOpen(dropdown, false);
    });
  });

  document.addEventListener("click", () => dropdowns.forEach((d) => setOpen(d, false)));
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    dropdowns.forEach((d) => {
      if (d.classList.contains("is-open")) {
        setOpen(d, false);
        d.querySelector<HTMLElement>("[data-dropdown-trigger]")?.focus();
      }
    });
    if (menu.classList.contains("is-open")) closeMenu();
  });

  // Mobile menu
  const menu = document.getElementById("mobile-menu")!;
  const openBtn = document.getElementById("menu-open")!;
  const closeBtn = document.getElementById("menu-close")!;

  function openMenu() {
    menu.classList.add("is-open");
    openBtn.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    closeBtn.focus();
  }
  function closeMenu() {
    menu.classList.remove("is-open");
    openBtn.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    openBtn.focus();
  }

  openBtn.addEventListener("click", openMenu);
  closeBtn.addEventListener("click", closeMenu);
</script>
