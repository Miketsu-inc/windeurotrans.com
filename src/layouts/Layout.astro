---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  locale: string;
  title?: string;
  description?: string;
}

const {
  locale,
  title,
  description = "Temperature-controlled, pharmaceutical (GDP) and ADR road freight from Hungary across Europe. Full and part loads from 1 kg to 24 tonnes, 24/7 dispatch.",
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Road freight you can count on`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f7fc" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="alternate" hreflang="hu" href={`${base}/hu/`} />
    <link rel="alternate" hreflang="en" href={`${base}/en/`} />
    <link rel="alternate" hreflang="it" href={`${base}/it/`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}/img/og.jpg`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="bg-signal text-ink fixed top-3 left-3 z-[100] -translate-y-20 rounded-md px-4 py-2 font-medium focus:translate-y-0"
      >Skip to content</a
    >
    <SiteHeader locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
