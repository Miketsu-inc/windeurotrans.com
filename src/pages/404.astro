---
import Layout from "../layouts/Layout.astro";
import { pageUrl } from "../data/site";

const locale = "en";
---

<Layout locale={locale} title="Page not found">
  <section class="wrap py-20 md:py-32">
    <div class="sign-panel max-w-3xl px-8 py-14 md:px-14 md:py-16">
      <p class="tnum text-navy-300 text-lg">404</p>
      <h1 class="mt-3 text-[2.5rem] leading-tight md:text-[3.25rem]">This road doesn't go anywhere.</h1>
      <p class="text-navy-200 mt-4 max-w-lg text-lg">
        The page may have moved, or the address has a typo. Start again from the home page, or call or email us.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={pageUrl(locale)} class="btn btn-signal">Go to the home page</a>
        <a href={pageUrl(locale, "contact")} class="btn btn-outline-light">Contact us</a>
      </div>
    </div>
  </section>
</Layout>
