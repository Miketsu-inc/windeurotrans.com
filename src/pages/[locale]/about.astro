---
import { Picture } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import driver from "../../assets/driver.webp";
import fleetAngle from "../../assets/fleet/fleet-angle.webp";
import { site } from "../../data/site";
import { getDictionary, getLocale, localeStaticPaths } from "../../i18n";

export const getStaticPaths = localeStaticPaths;

const locale = getLocale(Astro);
const t = getDictionary(locale);
const about = t.about;
const initials = site.founder
  .split(" ")
  .map((part) => part[0])
  .join("");
---

<Layout title={about.title} description={about.description}>
  <PageHero title={about.title} lead={about.lead} />

  <div class="bg-frost">
    <section class="wrap grid gap-12 py-16 md:py-24 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-center lg:gap-20">
      <div class="max-w-xl">
        <h2 class="text-[2rem] leading-tight md:text-[2.5rem]">{about.story.title}</h2>
        <div class="mt-6 space-y-4 text-lg">
          {about.story.paragraphs.map((p) => <p>{p}</p>)}
          <p class="text-muted">{about.story.belief}</p>
        </div>
      </div>
      <Picture
        src={fleetAngle}
        alt={about.story.imageAlt}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[600, 900, 1200]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="aspect-4/3 w-full rounded-2xl object-cover"
      />
    </section>
  </div>

  <section class="border-line border-y">
    <div class="wrap py-16 md:py-24">
      <h2 class="text-[2rem] leading-tight md:text-[2.5rem]">{about.principles.title}</h2>
      <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          about.principles.items.map((p) => (
            <li class="border-signal border-t-2 pt-6">
              <h3 class="text-xl">{p.title}</h3>
              <p class="text-muted mt-3">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="bg-frost">
    <section class="wrap grid gap-10 py-16 md:py-24 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 class="text-[2rem] leading-tight md:text-[2.5rem]">{about.timeline.title}</h2>
      <ol class="border-line relative border-l-2 pl-8">
        {
          about.timeline.items.map((item) => (
            <li class="relative pb-10 last:pb-0">
              <span
                class="bg-signal ring-frost absolute top-1.5 -left-[2.4rem] size-3.5 rounded-full ring-4"
                aria-hidden="true"
              />
              <p class="tnum text-2xl font-semibold">{item.year}</p>
              <p class="text-muted mt-1 max-w-lg text-lg">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <section class="border-line border-t">
    <div class="wrap py-16 md:py-24">
      <h2 class="text-[2rem] leading-tight md:text-[2.5rem]">{about.people.title}</h2>
      <div class="mt-12 grid gap-12 md:grid-cols-2 md:gap-14">
        <figure>
          <!-- Placeholder until there is a photo of the founder -->
          <div class="band-night flex aspect-3/2 w-full items-center justify-center rounded-2xl" aria-hidden="true">
            <span class="text-6xl font-semibold tracking-tight text-blue-300">{initials}</span>
          </div>
          <figcaption class="mt-5">
            <p class="text-xl font-semibold">{site.founder}</p>
            <p class="text-muted">{t.common.founderRole}</p>
            <p class="mt-3 max-w-md">{about.people.founder}</p>
          </figcaption>
        </figure>
        <figure>
          <Picture
            src={driver}
            alt={about.people.driverAlt}
            formats={["avif"]}
            fallbackFormat="webp"
            sizes="(min-width: 768px) 50vw, 100vw"
            class="aspect-3/2 w-full rounded-2xl object-cover"
          />
          <figcaption class="mt-5">
            <p class="text-xl font-semibold">{about.people.drivers}</p>
            <p class="mt-3 max-w-md">{about.people.driversText}</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>
</Layout>
