---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Photo from "../../components/Photo.astro";
import fleetAngle from "../../assets/fleet/fleet-angle.webp";
import Icon from "../../components/Icon.astro";
import { team } from "../../data/team";
import { getDictionary, getLocale, localeStaticPaths } from "../../i18n";

export const getStaticPaths = localeStaticPaths;

const locale = getLocale(Astro);
const t = getDictionary(locale);
const about = t.about;
const roles = { founder: t.common.founderRole, ...about.people.roles };
const initials = (name: string) =>
  name
    .split(" ")
    .map((part) => part[0])
    .join("");
---

<Layout title={about.title} description={about.description}>
  <PageHero title={about.title} lead={about.lead} />

  <div class="bg-frost">
    <section class="wrap grid gap-12 py-16 md:py-24 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-center lg:gap-20">
      <div class="max-w-xl">
        <h2 class="text-[2rem] leading-tight md:text-[2.5rem]">{about.story.title}</h2>
        <div class="mt-6 space-y-4 text-lg">
          {about.story.paragraphs.map((p) => <p>{p}</p>)}
          <p class="text-muted">{about.story.belief}</p>
        </div>
      </div>
      <Photo
        src={fleetAngle}
        alt={about.story.imageAlt}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={[600, 900, 1200]}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="aspect-4/3 w-full rounded-2xl object-cover"
      />
    </section>
  </div>

  <section class="border-line border-y">
    <div class="wrap py-16 md:py-24">
      <h2 class="text-[2rem] leading-tight md:text-[2.5rem]">{about.principles.title}</h2>
      <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
        {
          about.principles.items.map((p) => (
            <li class="border-signal border-t-2 pt-6">
              <h3 class="text-xl">{p.title}</h3>
              <p class="text-muted mt-3">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="bg-frost">
    <section class="wrap grid gap-10 py-16 md:py-24 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <h2 class="text-[2rem] leading-tight md:text-[2.5rem]">{about.timeline.title}</h2>
      <ol class="border-line relative border-l-2 pl-8">
        {
          about.timeline.items.map((item) => (
            <li class="relative pb-10 last:pb-0">
              <span
                class="bg-signal ring-frost absolute top-1.5 -left-[2.4rem] size-3.5 rounded-full ring-4"
                aria-hidden="true"
              />
              <p class="tnum text-2xl font-semibold">{item.year}</p>
              <p class="text-muted mt-1 max-w-lg text-lg">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  <section class="border-line border-t">
    <div class="wrap py-16 md:py-24">
      <h2 class="text-[2rem] leading-tight md:text-[2.5rem]">{about.people.title}</h2>
      <!--
        On wide screens each column is as wide as its longest line and the space is shared out between them,
        so the gaps look even and the emails never wrap. On small tablets, the photo sits beside the details.
      -->
      <ul class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 md:gap-x-8 xl:grid-cols-[repeat(4,auto)] xl:justify-between">
        {
          team.map((p) => (
            <li class="min-[30rem]:max-sm:flex min-[30rem]:max-sm:items-center min-[30rem]:max-sm:gap-6">
              <!-- Placeholder until there are photos -->
              <div
                class="band-night flex size-40 shrink-0 items-center justify-center rounded-2xl min-[30rem]:max-sm:size-32"
                aria-hidden="true"
              >
                <span class="text-4xl font-semibold tracking-tight text-blue-300">{initials(p.name)}</span>
              </div>
              <div class="mt-5 min-[30rem]:max-sm:mt-0">
                <p class="text-xl font-semibold">{p.name}</p>
                <p class="text-muted">{roles[p.role]}</p>
                <ul class="mt-4 space-y-2 text-[0.9375rem] whitespace-nowrap">
                  <li class="flex items-center gap-2.5">
                    <Icon name="mail" class="text-signal -ml-0.5 size-4.5 shrink-0" />
                    <a href={`mailto:${p.email}`} class="link">
                      {p.email}
                    </a>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <Icon name="phone" class="text-signal -ml-0.5 size-4.5 shrink-0" />
                    <a href={`tel:${p.phone.replaceAll(" ", "")}`} class="link tnum">
                      {p.phone}
                    </a>
                  </li>
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
