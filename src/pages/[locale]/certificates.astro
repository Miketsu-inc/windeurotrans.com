---
import type { GetStaticPaths } from "astro";
import { locales, type Locale } from "../../i18n/utils";

import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import CtaPanel from "../../components/CtaPanel.astro";
import Icon from "../../components/Icon.astro";
import { certificates } from "../../data/certificates";
import { asset, site } from "../../data/site";

export const getStaticPaths = (() => {
  return locales.map((locale) => ({ params: { locale } }));
}) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
---

<Layout
  locale={locale}
  title="Certificates"
  description="Wind Eurotrans holds GDP certification for road transport of medicines and ISO 9001:2015 certification for domestic and international transport and forwarding."
>
  <PageHero
    locale={locale}
    title="Certificates"
    lead="Independent auditors check how we work. These are the certificates in force today and what they cover."
    crumbs={[{ label: "Certificates" }]}
  />

  <div class="wrap py-16 md:py-24">
    {
      certificates.map((c, i) => (
        <section
          id={c.id}
          class:list={[
            "grid scroll-mt-28 gap-10 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-16",
            i > 0 && "border-line mt-16 border-t pt-16 md:mt-24 md:pt-24",
          ]}
        >
          <a href={asset(c.files[0].href)} class="group block self-start" target="_blank" rel="noopener">
            <img
              src={asset(c.image)}
              alt={`${c.title} certificate of ${site.legalName}`}
              width="900"
              height="1273"
              loading={i === 0 ? "eager" : "lazy"}
              class="border-line w-full rounded-md border bg-white shadow-[0_30px_50px_-30px_rgb(7_23_41/0.45)]"
            />
            <span class="text-muted mt-3 flex items-center gap-1.5 text-sm group-hover:text-ink">
              <Icon name="external" class="size-4" />
              Open full size
            </span>
          </a>

          <div>
            <h2 class="text-[1.75rem] leading-tight md:text-[2.25rem]">{c.title}</h2>
            <p class="text-muted mt-4 max-w-xl text-lg">{c.summary}</p>

            <dl class="border-line mt-10 border-t">
              {c.details.map((d) => (
                <div class="border-line grid gap-1 border-b py-4 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-6">
                  <dt class="text-muted text-[0.9375rem]">{d.label}</dt>
                  <dd class="font-medium">{d.value}</dd>
                </div>
              ))}
            </dl>

            <p class="mt-8 flex flex-wrap items-center gap-3">
              <span class="text-muted mr-1">Download:</span>
              {c.files.map((f) => (
                <a href={asset(f.href)} class="btn btn-outline min-h-10 px-4 py-2 text-[0.9375rem]" download>
                  <Icon name="doc" class="size-4.5" />
                  {f.label}
                </a>
              ))}
            </p>
          </div>
        </section>
      ))
    }
  </div>

  <CtaPanel
    title="Need our certificates for a supplier audit?"
    text="We can send copies and fill in your supplier quality questionnaire. Just ask when you get in touch."
    topic="certificates for a supplier audit"
  />
</Layout>
