---
import { Picture } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import HeroMap from "../../components/HeroMap.astro";
import ServiceScroller from "../../components/ServiceScroller.astro";
import WhyUs from "../../components/WhyUs.astro";
import OfficeMap from "../../components/OfficeMap.astro";
import driver from "../../assets/driver.webp";
import { site, emailParts } from "../../data/site";
import { getDictionary, getLocale, localeStaticPaths, localizedPath } from "../../i18n";

export const getStaticPaths = localeStaticPaths;

const locale = getLocale(Astro);
const t = getDictionary(locale);
const home = t.home;

const facts = [
  { icon: "road", ...home.facts.since },
  { icon: "thermometer", ...home.facts.temperature },
  { icon: "globe", ...home.facts.europe },
  { icon: "layers", ...home.facts.services },
] as const;
---

<Layout>
  <section class="bg-frost overflow-hidden bg-[radial-gradient(50%_60%_at_78%_48%,#e3edfb_0%,transparent_75%)]">
    <div
      class="wrap relative flex min-h-[calc(85svh-4rem)] flex-col justify-end gap-8 pt-16 pb-10 md:pb-14 lg:grid lg:min-h-0 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:grid-rows-[1fr_auto_auto_1fr] lg:gap-x-6 lg:gap-y-0 lg:pt-10 lg:pb-10"
    >
      <div class="relative z-10 lg:col-start-1 lg:row-start-2">
        <h1 class="text-[2.75rem] leading-none font-bold tracking-[-0.035em] sm:text-[4rem] xl:text-[4.75rem]">
          {home.hero.title}
        </h1>
        <p class="text-muted mt-6 max-w-lg text-lg md:text-xl md:leading-relaxed">{home.hero.text}</p>
      </div>
      <!-- Below desktop the map sits behind the text; on desktop it fills the right column and runs past it -->
      <div
        class="pointer-events-none absolute top-[32%] left-1/2 w-[min(40rem,125%)] -translate-1/2 opacity-60 md:w-[min(54rem,115%)] lg:pointer-events-auto lg:static lg:col-start-2 lg:row-span-4 lg:row-start-1 lg:-my-6 lg:-ml-16 lg:w-full lg:max-w-none lg:translate-0 lg:opacity-100 xl:w-[calc(100%+5.5rem)]"
      >
        <HeroMap />
      </div>
      <div class="relative z-10 flex gap-3 *:flex-1 sm:*:flex-none lg:col-start-1 lg:row-start-3 lg:mt-8">
        <a href={localizedPath(locale, "contact")} class="btn btn-signal">{home.hero.contact}</a>
        <a href={localizedPath(locale, "services")} class="btn btn-outline">{home.hero.services}</a>
      </div>
    </div>
  </section>

  <!-- On phones only the first two facts show, without their descriptions -->
  <section aria-label={home.facts.label} class="band-night">
    <ul class="wrap grid grid-cols-2 gap-x-5 gap-y-7 py-9 sm:gap-x-8 sm:gap-y-8 sm:py-12 md:py-16 lg:grid-cols-4">
      {
        facts.map((f) => (
          <li class="flex flex-col gap-2 border-white/20 even:border-l-2 even:pl-5 nth-[n+3]:hidden sm:flex-row sm:gap-4 sm:nth-[n+3]:flex lg:not-first:border-l-2 lg:not-first:pl-5">
            <Icon name={f.icon} class="text-signal mt-0.5 size-6 shrink-0" />
            <div>
              <p class="leading-snug font-semibold">{f.title}</p>
              <p class="mt-0.5 hidden text-[0.9375rem] leading-snug text-blue-200 sm:block">{f.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="bg-frost">
    <ServiceScroller />
  </div>

  <WhyUs />

  <section class="bg-frost">
    <div class="wrap grid gap-12 py-20 md:py-28 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:gap-20">
      <div>
        <p class="text-muted max-w-xl text-lg">{home.promise.text}</p>
        <figure class="mt-10">
          <blockquote>
            <p class="text-[1.75rem] leading-tight font-medium tracking-[-0.015em] md:text-[2.25rem]">
              “{home.promise.quote}”
            </p>
          </blockquote>
          <figcaption class="mt-8 flex items-center gap-4">
            <span class="bg-signal block h-10 w-1 rounded-full" aria-hidden="true"></span>
            <span>
              <span class="block font-semibold">{site.founder}</span>
              <span class="text-muted block text-[0.9375rem]">{t.common.founderRole}</span>
            </span>
          </figcaption>
        </figure>
        <a href={localizedPath(locale, "about")} class="link mt-10 inline-block">{home.promise.more}</a>
      </div>
      <Picture
        src={driver}
        alt={home.promise.imageAlt}
        formats={["avif"]}
        fallbackFormat="webp"
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="aspect-4/5 w-full rounded-2xl object-cover object-[35%_center]"
      />
    </div>
  </section>

  <section class="band-night">
    <div class="wrap grid gap-10 py-20 md:py-28 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <h2 class="text-[2rem] leading-tight md:text-[2.75rem]">{home.faq.title}</h2>
        <p class="mt-4 max-w-sm text-lg text-blue-200">{home.faq.text}</p>
      </div>
      <div>
        {
          home.faq.items.map((f) => (
            <details class="faq border-b border-white/15 last:border-b-0" data-faq>
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-medium">
                {f.q}
                <Icon name="chevron" class="faq__chevron mt-1 size-5 shrink-0" />
              </summary>
              <div class="faq__answer">
                <p class="max-w-2xl pb-7 text-blue-200">{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-frost" aria-labelledby="contact-title">
    <div class="wrap grid gap-10 py-20 md:py-28 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <h2 id="contact-title" class="text-[2rem] leading-tight md:text-[2.75rem]">{home.contact.title}</h2>
        <p class="text-muted mt-4 max-w-sm text-lg">{home.contact.text}</p>
      </div>

      <div class="border-line grid overflow-hidden rounded-xl border sm:grid-cols-2">
        <div class="bg-frost p-7 md:p-9">
          <h3 class="text-xl">{home.contact.talk}</h3>
          <dl class="mt-8 space-y-7">
            <div>
              <dt class="text-muted text-[0.9375rem]">{t.common.phone}</dt>
              <dd class="mt-1 text-[1.0625rem]">
                <a href={site.phoneHref} class="link tnum">{site.phone}</a>
              </dd>
            </div>
            <div>
              <dt class="text-muted text-[0.9375rem]">{t.common.email}</dt>
              <dd class="mt-1 text-[1.0625rem]">
                <a href={site.emailHref} class="link">{emailParts[0]}<wbr />{emailParts[1]}</a>
              </dd>
            </div>
            <div>
              <dt class="text-muted text-[0.9375rem]">{t.common.businessHours}</dt>
              <dd class="mt-1 text-[1.0625rem] font-semibold">{t.common.hours}</dd>
            </div>
          </dl>
        </div>

        <div class="bg-ice border-line relative flex min-h-88 flex-col justify-end border-t p-7 sm:border-t-0 sm:border-l md:p-9">
          <OfficeMap class="contact-map absolute inset-0 h-full w-full" />
          <div class="relative">
            <h3 class="text-xl">{home.contact.visit}</h3>
            <p class="mt-3 text-[1.0625rem]">
              {site.address.street}<br />{site.address.postcode} {site.address.city}, {t.common.country}
            </p>
            <a href={site.mapsLink} class="link mt-4 inline-block text-[0.9375rem]" target="_blank" rel="noopener">
              {t.common.getDirections}<span class="sr-only"> {t.meta.newTab}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* The office map fades out before the address */
  :global(.contact-map) {
    mask-image: linear-gradient(to bottom, #000 35%, transparent 70%);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq:first-child summary {
    padding-top: 0.25rem;
  }
  .faq__answer {
    overflow: hidden;
  }
  .faq :global(.faq__chevron) {
    transition: transform 0.3s ease;
  }
  .faq.is-open :global(.faq__chevron) {
    transform: rotate(180deg);
  }
</style>

<script>
  // Animate the answers' height on open and close
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLDetailsElement>("[data-faq]").forEach((faq) => {
    const summary = faq.querySelector("summary")!;
    const answer = faq.querySelector<HTMLElement>(".faq__answer")!;
    let anim: Animation | null = null;

    faq.classList.toggle("is-open", faq.open);
    faq.addEventListener("toggle", () => {
      if (!anim) faq.classList.toggle("is-open", faq.open);
    });

    summary.addEventListener("click", (e) => {
      if (reduce.matches) return;
      e.preventDefault();

      const opening = !faq.classList.contains("is-open");
      const from = anim ? answer.getBoundingClientRect().height : opening ? 0 : answer.scrollHeight;
      anim?.cancel();

      faq.classList.toggle("is-open", opening);
      if (opening) faq.open = true;
      const to = opening ? answer.scrollHeight : 0;

      anim = answer.animate(
        [
          { height: `${from}px`, opacity: opening ? 0 : 1 },
          { height: `${to}px`, opacity: opening ? 1 : 0 },
        ],
        { duration: 220, easing: "cubic-bezier(0.3, 0, 0.2, 1)" },
      );
      anim.onfinish = () => {
        anim = null;
        if (!opening) faq.open = false;
      };
    });
  });
</script>
