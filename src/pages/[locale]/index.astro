---
import type { GetStaticPaths } from "astro";
import { locales, type Locale } from "../../i18n/utils";

import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import HeroMap from "../../components/HeroMap.astro";
import ServiceScroller from "../../components/ServiceScroller.astro";
import { certificates } from "../../data/certificates";
import { photos, photoSrc, photoSrcset } from "../../data/fleet";
import { site, asset, pageUrl, emailParts } from "../../data/site";

export const getStaticPaths = (() => {
  return locales.map((locale) => ({ params: { locale } }));
}) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;

const proof = [
  { icon: "shield", title: "GDP certified", text: "Medicines by road, audited by URS" },
  { icon: "badge", title: "ISO 9001:2015", text: "Quality management, audited by DNV" },
  { icon: "dispatch", title: "24/7 dispatch", text: "Someone answers while your load is moving" },
  { icon: "road", title: "On the road since 2010", text: "Based in Dunakeszi, next to Budapest" },
] as const;

const fleetPreview = ["fleet-angle-near", "truck-side", "trailer-rear"];

const faqs = [
  {
    q: "Do you take part loads, or only full trucks?",
    a: "Both. A full truckload goes straight from pickup to delivery. A part load shares the trailer with other loads going the same way, so it costs less and takes a little longer.",
  },
  {
    q: "What is the smallest and largest load you carry?",
    a: "Anything from 1 kg up to 24 tonnes.",
  },
  {
    q: "Which countries do you deliver to?",
    a: "We drive in Hungary and across Europe. Tell us the pickup and delivery address and we confirm the route and transit time with the price.",
  },
  {
    q: "Can you carry medicines at +2 °C to +8 °C?",
    a: "Yes. We are GDP certified for road transport of medicinal products, and we carry them at +2 °C to +8 °C or +15 °C to +25 °C with a temperature record for every load.",
  },
  {
    q: "Do you handle customs?",
    a: "Yes. We handle export and import customs clearance, so the truck and the documents are ready at the same time.",
  },
  {
    q: "What happens if something goes wrong on the road?",
    a: "Our dispatch team works around the clock. If a delay or a problem comes up, we call you straight away with the facts and the fix, so you never have to chase us for news.",
  },
];
---

<Layout locale={locale}>
  <!-- Hero: on white, so it runs on from the header. Headline beside an animated route map; on phones the buttons follow the map. -->
  <section class="bg-frost overflow-hidden bg-[radial-gradient(50%_60%_at_78%_48%,#e3edfb_0%,transparent_75%)]">
    <div class="wrap grid pt-12 pb-12 md:pt-16 md:pb-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:grid-rows-[1fr_auto_auto_1fr] lg:gap-x-6 lg:pt-10 lg:pb-10">
      <div class="relative z-10 lg:col-start-1 lg:row-start-2">
        <h1 class="text-[2.75rem] leading-[1] font-bold tracking-[-0.035em] sm:text-[4rem] xl:text-[4.75rem]">
          Reliability you can count on.
        </h1>
        <p class="text-muted mt-6 max-w-lg text-lg md:text-xl md:leading-relaxed">
          Refrigerated, pharmaceutical and dangerous goods by road, from Hungary to anywhere in Europe. At the
          temperature and on the day we agreed with you.
        </p>
      </div>
      <div class="mx-auto mt-6 w-full max-w-[22rem] sm:max-w-[26rem] lg:col-start-2 lg:row-span-4 lg:row-start-1 lg:-my-6 lg:mr-0 lg:max-w-[44rem] xl:max-w-[48rem] min-[1400px]:-mr-14">
        <HeroMap />
      </div>
      <div class="relative z-10 mt-4 flex flex-wrap gap-3 lg:col-start-1 lg:row-start-3 lg:mt-8">
        <a href={pageUrl(locale, "contact")} class="btn btn-signal">Get in touch</a>
        <a href={pageUrl(locale, "services")} class="btn btn-outline">Our services</a>
      </div>
    </div>
  </section>

  <!-- Proof: the blue band that follows the white hero -->
  <section aria-label="Why shippers trust us" class="band-night">
    <ul class="wrap grid gap-x-8 gap-y-8 py-12 sm:grid-cols-2 md:py-16 lg:grid-cols-4">
      {
        proof.map((p) => (
          <li class="flex gap-4 border-l-2 border-white/20 pl-5 sm:border-l-0 sm:pl-0 sm:even:border-l-2 sm:even:pl-5 lg:[&:not(:first-child)]:border-l-2 lg:[&:not(:first-child)]:pl-5">
            <Icon name={p.icon} class="text-signal mt-0.5 size-6 shrink-0" />
            <div>
              <p class="font-semibold">{p.title}</p>
              <p class="text-blue-200 text-[0.9375rem] leading-snug">{p.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="bg-frost">
    <ServiceScroller locale={locale} />
  </div>

  <!-- Fleet: three photos linking to the full gallery -->
  <section class="bg-sky">
    <div class="wrap py-20 md:py-28">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-xl">
          <h2 class="text-[2rem] leading-tight md:text-[2.75rem]">Our fleet</h2>
          <p class="text-muted mt-4 text-lg">
            Scania trucks and refrigerated trailers, kept clean and in good repair. These are the trucks that carry
            your loads.
          </p>
        </div>
        <a href={pageUrl(locale, "fleet")} class="link shrink-0">See the whole fleet</a>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-3 md:gap-4 lg:grid-cols-3 lg:grid-rows-2">
        {
          fleetPreview.map((name, i) => {
            const p = photos.find((photo) => photo.name === name)!;
            return (
              <li class:list={[i === 0 && "col-span-2 lg:row-span-2"]}>
                <a href={pageUrl(locale, "fleet")} class="group relative block h-full overflow-hidden rounded-xl" tabindex="-1">
                  <img
                    src={photoSrc(p.name)}
                    srcset={photoSrcset(p.name)}
                    sizes={i === 0 ? "(min-width: 1280px) 800px, 100vw" : "(min-width: 1280px) 400px, 50vw"}
                    alt={p.alt}
                    width={p.width}
                    height={p.height}
                    loading="lazy"
                    class:list={[
                      "w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]",
                      i === 0 ? "aspect-[16/9] lg:absolute lg:inset-0 lg:aspect-auto lg:h-full" : "aspect-[4/3]",
                    ]}
                  />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- Promise -->
  <section class="bg-frost">
    <div class="wrap grid gap-12 py-20 md:py-28 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:gap-20">
      <div>
        <p class="text-muted max-w-xl text-lg">
          Spoiled chilled loads, careless ADR transport, drivers who don't show up, deliveries that arrive a day
          late. In freight, these are everyday problems. We started Wind Eurotrans in 2010 to be the company where
          they don't happen.
        </p>
        <blockquote class="mt-10">
          <p class="text-[1.75rem] leading-[1.25] font-medium tracking-[-0.015em] md:text-[2.25rem]">
            “We don't accept a job that would put the agreed delivery date at risk. The transit times we agree with
            you are the ones we keep.”
          </p>
          <footer class="mt-8 flex items-center gap-4">
            <span class="bg-signal block h-10 w-1 rounded-full" aria-hidden="true"></span>
            <span>
              <span class="block font-semibold">{site.founder.name}</span>
              <span class="text-muted block text-[0.9375rem]">{site.founder.role}</span>
            </span>
          </footer>
        </blockquote>
        <a href={pageUrl(locale, "about")} class="link mt-10 inline-block">More about us</a>
      </div>
      <img
        src={asset("img/driver-612.webp")}
        alt="Wind Eurotrans driver standing in front of his truck"
        width="612"
        height="408"
        loading="lazy"
        class="aspect-[4/5] w-full rounded-2xl object-cover object-[35%_center]"
      />
    </div>
  </section>

  <!-- Certificates -->
  <section class="band-night">
    <div class="wrap grid gap-12 py-20 md:py-28 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-20">
      <div>
        <h2 class="text-[2rem] leading-tight md:text-[2.75rem]">Checked by independent auditors</h2>
        <p class="text-blue-200 mt-4 max-w-md text-lg">
          Our quality management and our handling of medicines are certified by outside bodies, so you don't have to
          take our word for it.
        </p>
        <a href={pageUrl(locale, "certificates")} class="link link-light mt-6 inline-block">View the certificates</a>
      </div>
      <ul class="grid grid-cols-2 gap-5 sm:gap-8">
        {
          certificates.map((c) => (
            <li>
              <a href={pageUrl(locale, `certificates#${c.id}`)} class="group block">
                <img
                  src={asset(c.thumb)}
                  alt={`${c.name} certificate of ${site.legalName}`}
                  width="480"
                  height="679"
                  loading="lazy"
                  class="w-full rounded-md shadow-[0_30px_50px_-22px_rgb(0_0_0/0.6)] transition-transform duration-200 group-hover:-translate-y-1"
                />
                <p class="mt-4 font-semibold">{c.name}</p>
                <p class="text-blue-200 text-[0.9375rem]">Valid until {c.validUntil}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-ice">
    <div class="wrap grid gap-10 py-20 md:py-28 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
    <div>
      <h2 class="text-[2rem] leading-tight md:text-[2.75rem]">Questions shippers ask us</h2>
      <p class="text-muted mt-4 max-w-sm text-lg">
        Something else on your mind? Call us on <a href={site.phoneHref} class="link tnum">{site.phone}</a>.
      </p>
    </div>
    <div>
      {
        faqs.map((f) => (
          <details class="faq border-line border-b last:border-b-0" data-faq>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-medium">
              {f.q}
              <Icon name="chevron" class="faq__chevron text-blue-900 mt-1 size-5 shrink-0" />
            </summary>
            <div class="faq__answer">
              <p class="text-muted max-w-2xl pb-7">{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
    </div>
  </section>

  <!--
    Contact. Same split as the FAQ above, so the two close the page as a pair.
    The phone number is the one bold element: it is how most loads get booked.
  -->
  <section class="bg-frost" aria-labelledby="contact-title">
    <div class="wrap grid gap-10 py-20 md:py-28 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-16">
      <div>
        <h2 id="contact-title" class="text-[2rem] leading-tight md:text-[2.75rem]">Get in touch</h2>
        <p class="text-muted mt-4 max-w-sm text-lg">
          Call or email us with your load. You get a price and a transit time, usually within one working day.
        </p>
      </div>

      <div>
        <a
          href={site.phoneHref}
          class="contact-phone tnum text-blue-900 inline-block text-[2.75rem] leading-none font-bold tracking-[-0.035em] sm:text-[3.75rem] xl:text-[4.5rem]"
        >
          {site.phone}
        </a>

        <dl class="mt-12 grid gap-8 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-10 md:mt-14 xl:grid-cols-[auto_auto_auto] xl:justify-between">
          <div>
            <dt class="text-muted text-[0.9375rem]">Email</dt>
            <dd class="mt-1.5 text-lg font-medium">
              <a href={`mailto:${site.email}`} class="contact-link">{emailParts[0]}<wbr />{emailParts[1]}</a>
            </dd>
          </div>
          <div>
            <dt class="text-muted text-[0.9375rem]">Business hours</dt>
            <dd class="mt-1.5 text-lg font-medium">Monday to Friday<br />8:00–17:00</dd>
            <dd class="text-muted mt-1 max-w-[13rem] text-[0.9375rem]">Dispatch answers 24/7 for loads on the road.</dd>
          </div>
          <div>
            <dt class="text-muted text-[0.9375rem]">Office</dt>
            <dd class="mt-1.5 text-lg font-medium">
              {site.address.street}<br />{site.address.postcode} {site.address.city}<br />{site.address.country}
            </dd>
            <dd class="mt-1">
              <a href={site.mapsLink} class="link text-[0.9375rem]" target="_blank" rel="noopener">Get directions</a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* The phone number and email: the site's orange underline, drawn in on hover */
  .contact-phone,
  .contact-link {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.16em;
    transition: text-decoration-color 0.15s ease;
  }
  .contact-link {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .contact-phone:hover,
  .contact-link:hover {
    text-decoration-color: var(--color-signal);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq:first-child summary {
    padding-top: 0.25rem;
  }
  .faq__answer {
    overflow: hidden;
  }
  .faq :global(.faq__chevron) {
    transition: transform 0.3s ease;
  }
  .faq.is-open :global(.faq__chevron) {
    transform: rotate(180deg);
  }
</style>

<script>
  // Open and close the answers with a height animation instead of a jump
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLDetailsElement>("[data-faq]").forEach((faq) => {
    const summary = faq.querySelector("summary")!;
    const answer = faq.querySelector<HTMLElement>(".faq__answer")!;
    let anim: Animation | null = null;

    faq.classList.toggle("is-open", faq.open);
    faq.addEventListener("toggle", () => {
      if (!anim) faq.classList.toggle("is-open", faq.open);
    });

    summary.addEventListener("click", (e) => {
      if (reduce.matches) return;
      e.preventDefault();

      const opening = !faq.classList.contains("is-open");
      const from = anim ? answer.getBoundingClientRect().height : opening ? 0 : answer.scrollHeight;
      anim?.cancel();

      faq.classList.toggle("is-open", opening);
      if (opening) faq.open = true;
      const to = opening ? answer.scrollHeight : 0;

      anim = answer.animate(
        [
          { height: `${from}px`, opacity: opening ? 0 : 1 },
          { height: `${to}px`, opacity: opening ? 1 : 0 },
        ],
        { duration: 220, easing: "cubic-bezier(0.3, 0, 0.2, 1)" },
      );
      anim.onfinish = () => {
        anim = null;
        if (!opening) faq.open = false;
      };
    });
  });
</script>
