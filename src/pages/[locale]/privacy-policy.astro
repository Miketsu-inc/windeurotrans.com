---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { site } from "../../data/site";
import { format, getDictionary, getLocale, localeStaticPaths } from "../../i18n";
import { getPage } from "../../i18n/content";

export const getStaticPaths = localeStaticPaths;

const locale = getLocale(Astro);
const t = getDictionary(locale);
const page = t.privacy;
const { Content, headings } = await render(await getPage(locale, "privacy-policy"));
const toc = headings.filter((h) => h.depth === 2);
---

<Layout title={page.title} description={format(page.description, { name: site.legalName })}>
  <PageHero title={page.title} lead={format(page.lead, { name: site.legalName })} />

  <div class="bg-frost">
    <div class="wrap grid gap-12 py-16 md:py-24 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-20">
      <nav aria-labelledby="toc-title" class="lg:sticky lg:top-28 lg:self-start">
        <h2 id="toc-title" class="mb-3 text-base font-medium tracking-normal">{page.toc}</h2>
        <ol class="border-line border-l-2 text-[0.9375rem]">
          {
            toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="toc-link text-muted hover:text-ink -ml-0.5 block border-l-2 border-transparent py-1 pl-4"
                  data-toc={h.slug}
                >
                  {h.text}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <article class="prose-page">
        <Content />
      </article>
    </div>
  </div>
</Layout>

<style>
  .toc-link {
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .toc-link.is-active {
    border-color: var(--color-signal);
    color: var(--color-ink);
    font-weight: 500;
  }
</style>

<script>
  // Highlight the section whose heading last passed the upper third of the screen
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
  const headings = links.map((a) => document.getElementById(a.dataset.toc!)!);
  let ticking = false;

  function update() {
    ticking = false;
    const line = window.innerHeight * 0.3;
    let current = 0;
    headings.forEach((h, i) => {
      if (h.getBoundingClientRect().top <= line) current = i;
    });
    // At the very bottom the last headings can't reach the line
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = headings.length - 1;
    links.forEach((a, i) => {
      a.classList.toggle("is-active", i === current);
      if (i === current) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) requestAnimationFrame(update);
      ticking = true;
    },
    { passive: true },
  );
  update();
</script>
