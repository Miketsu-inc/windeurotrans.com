---
import type { GetStaticPaths } from "astro";
import { locales, type Locale } from "../../../i18n/utils";

import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import RangeBar from "../../../components/RangeBar.astro";
import TempRange from "../../../components/TempRange.astro";
import CtaPanel from "../../../components/CtaPanel.astro";
import Icon from "../../../components/Icon.astro";
import { services } from "../../../data/services";
import { formatRange } from "../../../data/temperature";
import { asset, pageUrl } from "../../../data/site";

export const getStaticPaths = (() => {
  return locales.map((locale) => ({ params: { locale } }));
}) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;

const included = [
  { icon: "dispatch", title: "24/7 dispatch", text: "Someone follows your load and picks up the phone, day and night." },
  { icon: "doc", title: "Complete paperwork", text: "CMR, ADR and customs documents prepared and checked before departure." },
  { icon: "badge", title: "Certified processes", text: "Every service runs under our ISO 9001:2015 quality management system." },
] as const;
---

<Layout
  locale={locale}
  title="Services"
  description="Road freight and forwarding, temperature-controlled transport, GDP pharmaceutical transport, ADR dangerous goods and customs clearance."
>
  <PageHero
    locale={locale}
    title="Services"
    lead="Full and part loads from 1 kg to 24 tonnes, at any temperature from −25 °C to +30 °C, with the paperwork handled."
    crumbs={[{ label: "Services" }]}
  />

  <section class="wrap py-16 md:py-24">
    <ul class="grid gap-14 md:gap-20">
      {
        services.map((s, i) => (
          <li class="grid gap-8 md:grid-cols-2 md:items-center md:gap-14">
            <img
              src={asset(s.image.src)}
              alt={s.image.alt}
              loading={i === 0 ? "eager" : "lazy"}
              class:list={["aspect-[3/2] w-full rounded-2xl object-cover", i % 2 === 1 && "md:order-last"]}
            />
            <div>
              <h2 class="text-[1.75rem] leading-tight md:text-[2.25rem]">{s.name}</h2>
              <p class="text-muted mt-4 max-w-lg text-lg">{s.lead}</p>
              {s.ranges.length > 0 && (
                <div class="mt-6 max-w-sm">
                  <RangeBar ranges={s.ranges} />
                  <p class="tnum text-muted mt-2 text-sm">{s.ranges.map(formatRange).join(", ")}</p>
                </div>
              )}
              <div class="mt-8 flex flex-wrap gap-3">
                <a href={pageUrl(locale, `services/${s.slug}`)} class="btn btn-navy">
                  About {s.name.charAt(0).toLowerCase() + s.name.slice(1)}
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <TempRange locale={locale} title="Which temperature does your cargo need?" />

  <section class="wrap py-16 md:py-24">
    <h2 class="text-[2rem] leading-tight md:text-[2.75rem]">Included with every load</h2>
    <ul class="mt-10 grid gap-8 md:grid-cols-3">
      {
        included.map((item) => (
          <li class="border-line border-l-2 pl-5">
            <Icon name={item.icon} class="text-navy-700 size-6" />
            <h3 class="mt-3 text-lg">{item.title}</h3>
            <p class="text-muted mt-1">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaPanel />
</Layout>
