---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import ServiceCard from "../../../components/ServiceCard.astro";
import Icon from "../../../components/Icon.astro";
import { site } from "../../../data/site";
import { format, getDictionary, getLocale, localeStaticPaths } from "../../../i18n";
import { getServices } from "../../../i18n/content";

export const getStaticPaths = localeStaticPaths;

const locale = getLocale(Astro);
const t = getDictionary(locale);
const page = t.services;
const services = await getServices(locale);

const included = [
  { icon: "dispatch", ...page.included.dispatch },
  { icon: "doc", ...page.included.paperwork },
  { icon: "badge", ...page.included.certified },
] as const;
---

<Layout title={page.title} description={page.description}>
  <PageHero title={page.title} lead={page.lead} />

  <div class="bg-frost">
    <section class="wrap py-16 md:py-24">
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <li>
              <ServiceCard service={s} eager={i < 3} />
            </li>
          ))
        }
        <li class="sign-panel flex flex-col p-8 md:p-9">
          <h2 class="text-xl leading-snug md:text-[1.375rem]">{page.help.title}</h2>
          <p class="mt-2 mb-6 text-blue-200">{page.help.text}</p>
          <div class="mt-auto flex flex-col gap-3">
            <a href={site.phoneHref} class="btn btn-signal tnum">
              <Icon name="phone" class="size-4.5" />
              {format(page.help.call, { phone: site.phone })}
            </a>
            <a href={site.emailHref} class="btn btn-outline-light">
              <Icon name="mail" class="size-4.5" />
              {page.help.email}
            </a>
          </div>
        </li>
      </ul>
    </section>
  </div>

  <section class="border-line border-y">
    <div class="wrap py-16 md:py-24">
      <h2 class="text-[2rem] leading-tight md:text-[2.75rem]">{page.included.title}</h2>
      <ul class="mt-10 grid gap-8 md:grid-cols-3">
        {
          included.map((item) => (
            <li class="border-line border-l-2 pl-5 md:first:border-l-0 md:first:pl-0">
              <Icon name={item.icon} class="size-6 text-blue-900" />
              <h3 class="mt-3 text-lg">{item.title}</h3>
              <p class="text-muted mt-1">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
