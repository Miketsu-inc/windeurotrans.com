---
import { defaultLocale, languageNames, locales, localizedPath, localizedUrl } from "../i18n";

const target = localizedPath(defaultLocale);
const paths = Object.fromEntries(locales.map((l) => [l, localizedPath(l)]));
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wind Eurotrans</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={localizedUrl(defaultLocale)} />
    <script is:inline define:vars={{ paths, fallback: target }}>
      // Send visitors to their browser's language if we have it, otherwise to the default
      const match = navigator.languages.map((l) => l.slice(0, 2)).find((l) => l in paths);
      location.replace(match ? paths[match] : fallback);
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <a href={target}>{languageNames[defaultLocale]}</a>
  </body>
</html>
